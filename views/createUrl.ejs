<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/createUrl.css">
</head>
<body>
    <%- include("partials/navbar") %>

    <div class="create-container">

        <div class="create-card">
        <div class="page-actions">

            <a href="/my-urls" class="back-btn">
                ← Back to My URLs
            </a>

        </div>
            <h2>Create Smart Link</h2>

            <p class="subtitle">
                Shorten and manage your URLs.
            </p>

            <form method="POST" action="/url">
                <div class="form-group">

                    <label for="originalUrl">
                        Original URL <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="originalUrl"
                        name="url"
                        placeholder="Paste your long URL here..."
                        value="<%= existingUrl || '' %>"
                    />

                </div>
                <div class="form-group">
                    <label>Custom Alias (Optional)</label>
                    <input
                        type="text"
                        id="customAlias"
                        name="customAlias"
                        placeholder="e.g resume"
                    />
                </div>
                <div class="form-group">
                    <label for="expiry">Expires In:</label>

                        <select name="expiry" id="expiry">
                            <option value="never">Never</option>
                            <option value="1">1 Day</option>
                            <option value="7">7 Days</option>
                            <option value="30">30 Days</option>
                        </select>
                </div>
                    <button
                        type="button"
                        id="suggestAliasBtn"
                        class="secondary-btn">

                        ✨ Suggest Alias

                    </button>

                    <button
                        type="submit"
                        class="primary-btn">

                        Create Smart Link

                    </button>
                <div id="aliasSuggestions" class="alias-suggestions"></div>
            </form>
            <div id="toast" class="toast">
                <span id="toastMessage"></span>
            </div>

        </div>

    </div>

</body>
<script src="/js/home.js"></script>
<script src="/js/toast.js"></script>
<script>

    const error = "<%= error %>";
    const shortId = "<%= shortId || '' %>";

    if (error === "urlExists") {

        showToast(
            `🔗 This link already exists. Your short URL is /${shortId}`
        );

    }

    if (error === "aliasExists") {
        showToast("⚠️ This alias is already taken. Please choose another one.");
    }



</script>
<div id="toast" class="toast">
    <span id="toastMessage"></span>
</div>

<script>

    const toast = document.getElementById("toast");
    const toastMessage = document.getElementById("toastMessage");

    function showToast(message) {

        toastMessage.textContent = message;

        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 2500);
    }

    const success = "<%= typeof success !== 'undefined' ? success : '' %>";

    if (success === "urlCreated") {

        showToast(
            "✅ Short URL created successfully!"
        );

    }

</script>
</html>