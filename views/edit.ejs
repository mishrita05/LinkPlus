<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/createUrl.css">
</head>
<body>
    <%- include("partials/navbar") %>

    <div class="create-container">

        <div class="create-card">
        <div class="page-actions">

            <a href="/my-urls" class="back-btn">
                ← Back to My URLs
            </a>

        </div>
            <h2>Edit Smart Link</h2>

            <p class="subtitle">
                Update your smart link.
            </p>

            <form method="POST" action="/url/edit/<%= url._id %>">
                <div class="form-group">

                    <label for="originalUrl">
                        Original URL <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="originalUrl"
                        name="url"
                        value="<%= url.reDirectUrl %>"
                        required
                    />

                </div>
                <div class="form-group">
                    <label>Custom Alias (Optional)</label>
                    <input
                        type="text"
                        id="customAlias"
                        name="customAlias"
                        value="<%= url.customAlias %>"
                    />
                </div>
                <div class="form-group">
                    <label for="expiry">Expires In:</label>

                        <select name="expiry" id="expiry">
                            <option value="never">Never</option>
                            <option value="1">1 Day</option>
                            <option value="7">7 Days</option>
                            <option value="30">30 Days</option>
                        </select>
                </div>

                    <button
                        type="submit"
                        class="primary-btn">

                        Update Smart Link

                    </button>
            </form>
            <div id="toast" class="toast">
                <span id="toastMessage"></span>
            </div>

        </div>

    </div>

</body>
<script src="/js/home.js"></script>
<script src="/js/toast.js"></script>
<script>

    const error = "<%= error || '' %>";

    if (error === "aliasExists") {

        showToast(
            "⚠️ This alias is already taken. Please choose another one."
        );

    }

    if (error === "urlExists") {

        showToast(
            "🔗 You already have a short link for this URL."
        );

    }

</script>

</html>